# ── Whisper (transcription) ───────────────────────────────────────────────────
# Model size options: tiny | base | medium | large-v3
# Start with "base" while developing (fast), switch to "medium" for production
WHISPER_MODEL=base

# Device: "cpu" works on any machine, "cuda" requires an Nvidia GPU
WHISPER_DEVICE=cuda

# ── Ollama (summarization) ────────────────────────────────────────────────────
# Make sure you've pulled the model first: ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434

# Max transcript segments sent to the LLM in one prompt.
# ~300 segments covers ~30-40 min of audio for most models.
# Increase if your meetings are longer and your model can handle it.
OLLAMA_TIMEOUT=360
