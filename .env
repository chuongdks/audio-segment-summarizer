# ── Whisper (transcription) ───────────────────────────────────────────────────
# Model size options: tiny | base | medium | large-v3
# Start with "base" while developing (fast), switch to "medium" for production
WHISPER_MODEL=base

# Device: "cpu" works on any machine, "cuda" requires an Nvidia GPU
WHISPER_DEVICE=cpu

# ── Ollama (summarization) ────────────────────────────────────────────────────
# Make sure you've pulled the model first: ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434

# How long to wait for Ollama to respond (seconds)
# Increase this if you're running a large model on CPU
OLLAMA_TIMEOUT=120
